# THEIA Interview Prep System - Environment Configuration

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME="THEIA Interview Prep System"
VERSION=1.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-10-01

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json

# Vertex AI Settings
VERTEX_AI_MODEL=gemini-1.5-pro
VERTEX_AI_LOCATION=us-central1

# Salesforce Configuration
SF_USERNAME=your_salesforce_username
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_salesforce_security_token
SF_DOMAIN=login
SALESFORCE_API_VERSION=v58.0

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# WebSocket Settings
MAX_WEBSOCKET_CONNECTIONS=50
WEBSOCKET_TIMEOUT=300
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=300

# Session Settings
SESSION_TTL=7200
MAX_CONCURRENT_SESSIONS=50
SESSION_CLEANUP_INTERVAL=300

# Memory Settings
MAX_MEMORY_PERCENT=80.0
MEMORY_CLEANUP_THRESHOLD=70.0
MEMORY_MONITOR_INTERVAL=30

# Interview Settings
MAX_INTERVIEW_DURATION=3600
MAX_QUESTIONS=10
MAX_QUESTION_LENGTH=1000
MAX_ANSWER_LENGTH=5000

# Agent Timeout Settings (seconds)
AGENT_TIMEOUT_DEFAULT=30
AGENT_TIMEOUT_RESEARCH=60
AGENT_TIMEOUT_EVALUATION=45

# Logging Settings
LOG_LEVEL=INFO
ENABLE_SQL_LOGGING=false

# CORS Settings (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000


# Auth0 Configuration (SOC2: least-privilege; rotate regularly)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://theia.api
AUTH0_CLIENT_ID=your_auth0_client_id

# THEIA Token Signing (server-issued, for internal propagation)
THEIA_JWT_ISSUER=theia
THEIA_JWT_AUDIENCE=theia-clients
THEIA_JWT_SECRET=please_change_and_store_securely
THEIA_JWT_TTL_SECONDS=7200

